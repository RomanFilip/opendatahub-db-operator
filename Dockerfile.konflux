# Konflux / RHOAI production build for red-hat-data-services/rhai-db-operator.
# Image labels use downstream rhai-db branding; chart/RBAC may still use odh-db-operator-*.
# Local/Kind development continues to use Containerfile.

ARG SOURCE_CODE=.

# Build the manager binary
FROM registry.access.redhat.com/ubi9/go-toolset:1.26@sha256:f9e171ed4a2ecfd284b6d977d60f6a0ed33eac8628ad806a80cdf3521cb8bede AS builder

# Built-in build args are not automatically available inside stages; redeclare them.
ARG TARGETOS TARGETARCH
RUN echo "GOOS=${TARGETOS} GOARCH=${TARGETARCH}"

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Cache deps before building and copying source so that we don't need to
# re-download as much and so that source changes don't invalidate our
# downloaded layer.
RUN go mod download

# Copy only the source needed to build the manager binary.
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
COPY pkg/ pkg/

# Build (FIPS-capable, matching other RHOAI Go operators)
USER root
RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOEXPERIMENT=strictfipsruntime \
    go build -tags strictfipsruntime -a -o manager ./cmd/main.go

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:b3a0b012de0c578082e1bc5b01c8bc27461b4eeb571a0b1a2b21a07dbd845a62 AS runtime

ARG USER=65532

LABEL com.redhat.component="rhai-db-container" \
      name="managed-open-data-hub/rhai-db-rhel9" \
      summary="Red Hat OpenShift AI shared database infrastructure operator" \
      description="Kubernetes operator providing the shared database infrastructure service for Red Hat OpenShift AI" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.k8s.display-name="rhai-db" \
      io.k8s.description="Kubernetes operator providing the shared database infrastructure service for Red Hat OpenShift AI" \
      io.openshift.expose-services="" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

WORKDIR /
COPY --from=builder /workspace/manager .
USER ${USER}

ENTRYPOINT ["/manager", "operator"]
