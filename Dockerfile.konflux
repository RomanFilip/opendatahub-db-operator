# Konflux / RHOAI production build for rhai-db-operator.
# Local/Kind development continues to use Containerfile.

ARG SOURCE_CODE=.

# Build the manager binary
FROM registry.access.redhat.com/ubi9/go-toolset:1.26@sha256:6f246e8913d082df463b62a74c72f0d2b410583e1b2ac48add39cd7ede59ce62 AS builder

# Built-in build args are not automatically available inside stages; redeclare them.
ARG TARGETOS TARGETARCH
RUN echo "GOOS=${TARGETOS} GOARCH=${TARGETARCH}"

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Cache deps before building and copying source so that we don't need to
# re-download as much and so that source changes don't invalidate our
# downloaded layer.
RUN go mod download

# Copy only the source needed to build the manager binary.
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
COPY pkg/ pkg/

# Build (FIPS-capable, matching other RHOAI Go operators)
USER root
RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOEXPERIMENT=strictfipsruntime \
    go build -tags strictfipsruntime -a -o manager ./cmd/main.go

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:db10c80537d786068c7c911d7ef6ea103315d0615fa4b39b5946f7976563a8d7 AS runtime

ARG USER=65532

LABEL com.redhat.component="odh-db-operator-container" \
      name="managed-open-data-hub/odh-db-operator-rhel9" \
      summary="Open Data Hub database infrastructure operator" \
      description="Kubernetes operator providing the shared database infrastructure service for OpenShift AI / Open Data Hub" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.k8s.display-name="odh-db-operator" \
      io.k8s.description="Kubernetes operator providing the shared database infrastructure service for OpenShift AI / Open Data Hub" \
      io.openshift.expose-services="" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

WORKDIR /
COPY --from=builder /workspace/manager .
USER ${USER}

ENTRYPOINT ["/manager", "operator"]
